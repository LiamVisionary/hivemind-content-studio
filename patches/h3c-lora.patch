+/* W += up @ down on a BF16 matrix in place, fusing LoRA adapters at load.
+ * `up` is rows x rank with the adapters' scales folded in; `down_columns` is
+ * the down factor stored column-major, columns x rank. */
+int h3_gpu_lora_fuse_bf16(h3_gpu *gpu, h3_gpu_tensor *weight,
+                          const h3_gpu_tensor *up,
+                          const h3_gpu_tensor *down_columns, uint32_t rows,
+                          uint32_t columns, uint32_t rank);
