             @"h3_linear_f32_tiled_bf16_map",
             @"h3_cast_f32_to_bf16",
             @"h3_cast_bf16_to_f32",
+            @"h3_lora_fuse_bf16",
             @"h3_rms_norm_f32",
             @"h3_scale_add_f32", @"h3_layer_norm_f32",
             @"h3_video_qkv_rope_f32",
@@ -2938,6 +2939,47 @@ int h3_gpu_quantize_weight_int8(h3_gpu *opaque, h3_gpu_tensor *output,
         1.0f, @"BF16 weight to quantize");
 }
 
+typedef struct { uint32_t rows, columns, rank, reserved; } lora_fuse_args;
+
+int h3_gpu_lora_fuse_bf16(h3_gpu *opaque, h3_gpu_tensor *weight,
+                          const h3_gpu_tensor *up,
+                          const h3_gpu_tensor *down_columns, uint32_t rows,
+                          uint32_t columns, uint32_t rank) {
+    H3GPU *gpu = GPU(opaque);
+    if (!rows || !columns || !rank ||
+        (uint64_t)rows * columns > UINT32_MAX ||
+        !h3_gpu_require_bf16(gpu, weight, (size_t)rows * columns,
+                             @"LoRA target weight") ||
+        !h3_gpu_require_f32(gpu, up, (size_t)rows * rank,
+                            @"LoRA up factor") ||
+        !h3_gpu_require_f32(gpu, down_columns, (size_t)columns * rank,
+                            @"LoRA down factor") ||
+        !h3_gpu_require_command(gpu)) return 0;
+    id<MTLComputePipelineState> pipeline =
+        h3_gpu_pipeline(gpu, @"h3_lora_fuse_bf16");
+    if (!pipeline) return 0;
+    lora_fuse_args args = {rows, columns, rank, 0};
+    @autoreleasepool {
+        id<MTLComputeCommandEncoder> encoder =
+            [gpu.command computeCommandEncoder];
+        [encoder setComputePipelineState:pipeline];
+        [encoder setBuffer:TENSOR(weight).buffer offset:0 atIndex:0];
+        [encoder setBuffer:TENSOR(up).buffer offset:0 atIndex:1];
+        [encoder setBuffer:TENSOR(down_columns).buffer offset:0 atIndex:2];
+        [encoder setBytes:&args length:sizeof(args) atIndex:3];
+        NSUInteger width = MAX((NSUInteger)1, pipeline.threadExecutionWidth);
+        NSUInteger height = MAX((NSUInteger)1,
+                                pipeline.maxTotalThreadsPerThreadgroup / width);
+        [encoder dispatchThreads:MTLSizeMake(columns, rows, 1)
+           threadsPerThreadgroup:MTLSizeMake(width, height, 1)];
+        [encoder endEncoding];
+    }
+    h3_gpu_stats stats = gpu.stats;
+    stats.direct_dispatches++;
+    gpu.stats = stats;
+    return 1;
+}
