diff --git a/h3_lora.c b/h3_lora.c
new file mode 100644
index 0000000..cf06e21
--- /dev/null
+++ b/h3_lora.c
@@ -0,0 +1,587 @@
+#include "h3_lora.h"
+
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Published H3 LoRAs are rank 16 to 64. The bound only stops a malformed
+ * header from sizing an absurd factor buffer. */
+enum { MAX_RANK = 4096, NAME_BYTES = 512 };
+
+typedef struct {
+    char *target;
+    size_t file;
+    const h3_st_tensor *up;
+    const h3_st_tensor *down;
+    uint64_t rows;
+    uint64_t columns;
+    uint64_t rank;
+    float scale;
+} h3_lora_adapter;
+
+struct h3_lora_set {
+    h3_st_header *files;
+    size_t file_count;
+    /* Sorted by target, then by file, so one tensor's adapters are adjacent
+     * and stack in the order they were given. */
+    h3_lora_adapter *adapters;
+    size_t adapter_count;
+    size_t adapter_capacity;
+    size_t tensor_count;
+    size_t skipped;
+    char skip_detail[384];
+};
+
+typedef enum { PART_OTHER, PART_DOWN, PART_UP, PART_ALPHA } lora_part;
+
+/* The two pair spellings, ComfyUI/PEFT first and kohya second. */
+static const char *const down_suffix[2] = {".lora_A.weight", ".lora_down.weight"};
+static const char *const up_suffix[2] = {".lora_B.weight", ".lora_up.weight"};
+static const char alpha_suffix[] = ".alpha";
+
+static void fail(char *error, size_t error_size, const char *format, ...) {
+    if (!error || !error_size) return;
+    va_list arguments;
+    va_start(arguments, format);
+    vsnprintf(error, error_size, format, arguments);
+    va_end(arguments);
+}
+
+static const char *base_name(const char *path) {
+    const char *slash = strrchr(path, '/');
+    return slash ? slash + 1 : path;
+}
+
+static int has_suffix(const char *text, const char *suffix, size_t *stem) {
+    size_t length = strlen(text);
+    size_t tail = strlen(suffix);
+    if (length <= tail || strcmp(text + length - tail, suffix) != 0) return 0;
+    *stem = length - tail;
+    return 1;
+}
+
+static lora_part classify(const char *name, int *family, size_t *stem) {
+    for (int spelling = 0; spelling < 2; spelling++) {
+        if (has_suffix(name, down_suffix[spelling], stem)) {
+            *family = spelling;
+            return PART_DOWN;
+        }
+        if (has_suffix(name, up_suffix[spelling], stem)) {
+            *family = spelling;
+            return PART_UP;
+        }
+    }
+    if (has_suffix(name, alpha_suffix, stem)) return PART_ALPHA;
+    return PART_OTHER;
+}
+
+/* The first `stem` bytes of name, then suffix. 0 when it does not fit. */
+static int compose(char *out, size_t size, const char *name, size_t stem,
+                   const char *suffix) {
+    if (stem >= size) return 0;
+    int written = snprintf(out, size, "%.*s%s", (int)stem, name, suffix);
+    return written >= 0 && (size_t)written < size;
+}
+
+static float bf16_value(uint16_t value) {
+    uint32_t bits = (uint32_t)value << 16;
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+static float f16_value(uint16_t value) {
+    uint32_t sign = (uint32_t)(value & 0x8000u) << 16;
+    uint32_t exponent = ((uint32_t)value >> 10) & 0x1fu;
+    uint32_t mantissa = (uint32_t)value & 0x3ffu;
+    uint32_t bits;
+    if (exponent == 0x1fu) {
+        bits = sign | 0x7f800000u | (mantissa << 13);
+    } else if (exponent) {
+        bits = sign | ((exponent + 112u) << 23) | (mantissa << 13);
+    } else if (mantissa) {
+        /* A subnormal half is a normal single: shift it into place. */
+        exponent = 113u;
+        while (!(mantissa & 0x400u)) {
+            mantissa <<= 1;
+            exponent--;
+        }
+        bits = sign | (exponent << 23) | ((mantissa & 0x3ffu) << 13);
+    } else {
+        bits = sign;
+    }
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+static int factor_dtype(h3_dtype dtype) {
+    return dtype == H3_DTYPE_F32 || dtype == H3_DTYPE_F16 ||
+           dtype == H3_DTYPE_BF16;
+}
+
+/* A factor or a scalar alpha as F32, whatever it is stored as. */
+static int read_values(const h3_st_header *header, const h3_st_tensor *tensor,
+                       float *values, size_t count,
+                       char *error, size_t error_size) {
+    if (h3_st_tensor_elements(tensor) != count || !factor_dtype(tensor->dtype)) {
+        fail(error, error_size, "%s is not a %zu-element F32/F16/BF16 tensor",
+             tensor->name, count);
+        return 0;
+    }
+    if (tensor->dtype == H3_DTYPE_F32)
+        return h3_st_read_data(header, tensor, values, count * sizeof(*values),
+                               error, error_size);
+    uint16_t *raw = malloc(count * sizeof(*raw));
+    if (!raw) {
+        fail(error, error_size, "out of memory reading %s", tensor->name);
+        return 0;
+    }
+    int ok = h3_st_read_data(header, tensor, raw, count * sizeof(*raw),
+                             error, error_size);
+    for (size_t index = 0; ok && index < count; index++) {
+        values[index] = tensor->dtype == H3_DTYPE_BF16 ?
+            bf16_value(raw[index]) : f16_value(raw[index]);
+    }
+    free(raw);
+    return ok;
+}
+
+/* kohya writes a parameter path with every dot as an underscore. */
+static int kohya_equals(const char *checkpoint, size_t length,
+                        const char *kohya, size_t kohya_length) {
+    if (length != kohya_length) return 0;
+    for (size_t index = 0; index < length; index++) {
+        char expected = checkpoint[index] == '.' ? '_' : checkpoint[index];
+        if (expected != kohya[index]) return 0;
+    }
+    return 1;
+}
+
+/* The transformer weight an adapter stem names. *matches is how many do, which
+ * only the kohya spelling can make more than one. */
+static const h3_st_tensor *resolve_target(const h3_weight_store *store,
+                                          const char *name, size_t stem,
+                                          size_t *matches) {
+    static const char comfy_prefix[] = "diffusion_model.";
+    static const char kohya_prefix[] = "lora_unet_";
+    static const char weight_suffix[] = ".weight";
+    *matches = 0;
+    if (stem > sizeof(kohya_prefix) - 1 &&
+        !strncmp(name, kohya_prefix, sizeof(kohya_prefix) - 1)) {
+        const char *kohya = name + sizeof(kohya_prefix) - 1;
+        size_t kohya_length = stem - (sizeof(kohya_prefix) - 1);
+        const h3_st_tensor *found = NULL;
+        for (size_t shard = 0; shard < h3_weight_store_shards(store); shard++) {
+            const h3_st_header *header = h3_weight_store_header(store, shard);
+            for (size_t index = 0; header && index < header->tensor_count;
+                 index++) {
+                const h3_st_tensor *tensor = &header->tensors[index];
+                size_t length = 0;
+                if (has_suffix(tensor->name, weight_suffix, &length) &&
+                    kohya_equals(tensor->name, length, kohya, kohya_length)) {
+                    found = tensor;
+                    (*matches)++;
+                }
+            }
+        }
+        return found;
+    }
+    const char *parameter = name;
+    size_t parameter_length = stem;
+    if (stem > sizeof(comfy_prefix) - 1 &&
+        !strncmp(name, comfy_prefix, sizeof(comfy_prefix) - 1)) {
+        parameter += sizeof(comfy_prefix) - 1;
+        parameter_length -= sizeof(comfy_prefix) - 1;
+    }
+    char candidate[NAME_BYTES];
+    if (!compose(candidate, sizeof(candidate), parameter, parameter_length,
+                 weight_suffix)) return NULL;
+    const h3_st_tensor *tensor = h3_weight_find(store, candidate, NULL);
+    if (tensor) *matches = 1;
+    return tensor;
+}
+
+static int append_adapter(h3_lora_set *set, const h3_lora_adapter *adapter) {
+    if (set->adapter_count == set->adapter_capacity) {
+        size_t next = set->adapter_capacity ? set->adapter_capacity * 2 : 64;
+        h3_lora_adapter *grown = realloc(set->adapters, next * sizeof(*grown));
+        if (!grown) return 0;
+        set->adapters = grown;
+        set->adapter_capacity = next;
+    }
+    set->adapters[set->adapter_count++] = *adapter;
+    return 1;
+}
+
+static int compare_adapters(const void *left, const void *right) {
+    const h3_lora_adapter *a = left;
+    const h3_lora_adapter *b = right;
+    int order = strcmp(a->target, b->target);
+    if (order) return order;
+    return (a->file > b->file) - (a->file < b->file);
+}
+
+h3_lora_set *h3_lora_set_open(const h3_weight_store *store,
+                              const h3_lora *loras, size_t count,
+                              char *error, size_t error_size) {
+    if (error && error_size) error[0] = '\0';
+    if (!store || !count || !loras || count > H3_MAX_LORAS) {
+        fail(error, error_size, "invalid LoRA set arguments");
+        return NULL;
+    }
+    h3_lora_set *set = calloc(1, sizeof(*set));
+    if (set) set->files = calloc(count, sizeof(*set->files));
+    if (!set || !set->files) {
+        free(set);
+        fail(error, error_size, "out of memory opening LoRA adapters");
+        return NULL;
+    }
+    char detail[384];
+    for (size_t file = 0; file < count; file++) {
+        const h3_lora *lora = &loras[file];
+        if (!lora->path || !*lora->path || !isfinite(lora->strength)) {
+            fail(error, error_size,
+                 "LoRA %zu needs a path and a finite strength", file + 1);
+            goto failed;
+        }
+        const char *label = base_name(lora->path);
+        if (!h3_st_read_header(lora->path, &set->files[file], detail,
+                               sizeof(detail))) {
+            fail(error, error_size, "LoRA %s: %s", label, detail);
+            goto failed;
+        }
+        set->file_count = file + 1;
+        const h3_st_header *header = &set->files[file];
+        size_t pairs = 0, fitting = 0;
+        size_t first_adapter = set->adapter_count;
+        char file_skip[320] = "";
+        for (size_t index = 0; index < header->tensor_count; index++) {
+            const h3_st_tensor *tensor = &header->tensors[index];
+            int family = 0;
+            size_t stem = 0;
+            lora_part part = classify(tensor->name, &family, &stem);
+            char partner[NAME_BYTES];
+            if (part == PART_OTHER) {
+                fail(error, error_size,
+                     "LoRA %s: %s is not a factor this engine can fuse "
+                     "(lora_A/lora_B, lora_down/lora_up and alpha only)",
+                     label, tensor->name);
+                goto failed;
+            }
+            if (part != PART_DOWN) {
+                /* Pairs are checked from the down factor; an up factor or an
+                 * alpha only has to have one beside it. */
+                int paired = 0;
+                for (int spelling = 0; spelling < 2 && !paired; spelling++) {
+                    if (part == PART_UP && spelling != family) continue;
+                    paired = compose(partner, sizeof(partner), tensor->name,
+                                     stem, down_suffix[spelling]) &&
+                             h3_st_find(header, partner) != NULL;
+                }
+                if (!paired) {
+                    fail(error, error_size,
+                         "LoRA %s: %s has no down factor beside it",
+                         label, tensor->name);
+                    goto failed;
+                }
+                continue;
+            }
+            pairs++;
+            const h3_st_tensor *down = tensor;
+            const h3_st_tensor *up =
+                compose(partner, sizeof(partner), tensor->name, stem,
+                        up_suffix[family]) ? h3_st_find(header, partner) : NULL;
+            if (!up) {
+                fail(error, error_size,
+                     "LoRA %s: %s has no up factor beside it",
+                     label, tensor->name);
+                goto failed;
+            }
+            if (down->ndim != 2 || up->ndim != 2 ||
+                !factor_dtype(down->dtype) || !factor_dtype(up->dtype)) {
+                fail(error, error_size,
+                     "LoRA %s: %.*s is not a 2-D F32/F16/BF16 linear adapter",
+                     label, (int)stem, tensor->name);
+                goto failed;
+            }
+            uint64_t rank = down->shape[0];
+            if (!rank || rank > MAX_RANK || up->shape[1] != rank) {
+                fail(error, error_size,
+                     "LoRA %s: %.*s has factors of rank %llu and %llu",
+                     label, (int)stem, tensor->name, (unsigned long long)rank,
+                     (unsigned long long)up->shape[1]);
+                goto failed;
+            }
+            size_t matches = 0;
+            const h3_st_tensor *target =
+                resolve_target(store, tensor->name, stem, &matches);
+            if (!target) {
+                fail(error, error_size,
+                     "LoRA %s: %.*s names no MiniMax H3 transformer weight "
+                     "(is it a LoRA for another model?)",
+                     label, (int)stem, tensor->name);
+                goto failed;
+            }
+            if (matches > 1) {
+                fail(error, error_size,
+                     "LoRA %s: %.*s matches %zu transformer weights",
+                     label, (int)stem, tensor->name, matches);
+                goto failed;
+            }
+            if (target->dtype != H3_DTYPE_BF16 || target->ndim != 2) {
+                fail(error, error_size,
+                     "LoRA %s: %.*s targets %s, a %s tensor with %d "
+                     "dimensions; only BF16 matrices are fused",
+                     label, (int)stem, tensor->name, target->name,
+                     h3_dtype_name(target->dtype), target->ndim);
+                goto failed;
+            }
+            if (target->shape[0] != up->shape[0] ||
+                target->shape[1] != down->shape[1]) {
+                set->skipped++;
+                if (!file_skip[0]) {
+                    snprintf(file_skip, sizeof(file_skip),
+                             "%s is %llux%llu, its adapter %llux%llu",
+                             target->name,
+                             (unsigned long long)target->shape[0],
+                             (unsigned long long)target->shape[1],
+                             (unsigned long long)up->shape[0],
+                             (unsigned long long)down->shape[1]);
+                }
+                if (!set->skip_detail[0]) {
+                    snprintf(set->skip_detail, sizeof(set->skip_detail),
+                             "%s: %s", label, file_skip);
+                }
+                continue;
+            }
+            for (size_t other = first_adapter; other < set->adapter_count;
+                 other++) {
+                if (!strcmp(set->adapters[other].target, target->name)) {
+                    fail(error, error_size,
+                         "LoRA %s: two adapters target %s", label,
+                         target->name);
+                    goto failed;
+                }
+            }
+            float alpha_scale = 1.0f;
+            const h3_st_tensor *alpha =
+                compose(partner, sizeof(partner), tensor->name, stem,
+                        alpha_suffix) ? h3_st_find(header, partner) : NULL;
+            if (alpha) {
+                float value = 0.0f;
+                if (!read_values(header, alpha, &value, 1, detail,
+                                 sizeof(detail))) {
+                    fail(error, error_size, "LoRA %s: %s", label, detail);
+                    goto failed;
+                }
+                if (!isfinite(value)) {
+                    fail(error, error_size, "LoRA %s: %s is not finite",
+                         label, alpha->name);
+                    goto failed;
+                }
+                alpha_scale = value / (float)rank;
+            }
+            fitting++;
+            /* ComfyUI loads nothing at strength zero, and nor does this. */
+            if (lora->strength == 0.0f) continue;
+            h3_lora_adapter adapter = {
+                strdup(target->name), file, up, down, target->shape[0],
+                target->shape[1], rank, lora->strength * alpha_scale
+            };
+            if (!adapter.target || !append_adapter(set, &adapter)) {
+                free(adapter.target);
+                fail(error, error_size, "out of memory recording LoRA adapters");
+                goto failed;
+            }
+        }
+        if (!pairs) {
+            fail(error, error_size, "LoRA %s contains no adapters", label);
+            goto failed;
+        }
+        if (!fitting) {
+            fail(error, error_size,
+                 "LoRA %s: none of its %zu adapters fit this checkpoint (%s)",
+                 label, pairs, file_skip);
+            goto failed;
+        }
+    }
+    if (set->adapter_count > 1) {
+        qsort(set->adapters, set->adapter_count, sizeof(*set->adapters),
+              compare_adapters);
+    }
+    for (size_t index = 0; index < set->adapter_count; index++) {
+        if (!index || strcmp(set->adapters[index - 1].target,
+                             set->adapters[index].target))
+            set->tensor_count++;
+    }
+    return set;
+failed:
+    h3_lora_set_free(set);
+    return NULL;
+}
+
+void h3_lora_set_free(h3_lora_set *set) {
+    if (!set) return;
+    for (size_t index = 0; index < set->adapter_count; index++)
+        free(set->adapters[index].target);
+    free(set->adapters);
+    for (size_t index = 0; index < set->file_count; index++)
+        h3_st_free_header(&set->files[index]);
+    free(set->files);
+    free(set);
+}
+
+size_t h3_lora_set_files(const h3_lora_set *set) {
+    return set ? set->file_count : 0;
+}
+
+size_t h3_lora_set_adapters(const h3_lora_set *set) {
+    return set ? set->adapter_count : 0;
+}
+
+size_t h3_lora_set_tensors(const h3_lora_set *set) {
+    return set ? set->tensor_count : 0;
+}
+
+size_t h3_lora_set_skipped(const h3_lora_set *set) {
+    return set ? set->skipped : 0;
+}
+
+const char *h3_lora_set_skip_detail(const h3_lora_set *set) {
+    return set ? set->skip_detail : "";
+}
+
+static size_t first_adapter_for(const h3_lora_set *set, const char *name) {
+    size_t low = 0, high = set->adapter_count;
+    while (low < high) {
+        size_t middle = low + (high - low) / 2;
+        if (strcmp(set->adapters[middle].target, name) < 0) low = middle + 1;
+        else high = middle;
+    }
+    return low;
+}
+
+int h3_lora_set_targets(const h3_lora_set *set, const char *name) {
+    if (!set || !name) return 0;
+    size_t index = first_adapter_for(set, name);
+    return index < set->adapter_count &&
+           !strcmp(set->adapters[index].target, name);
+}
+
+int h3_lora_set_fuse_bf16(const h3_lora_set *set, h3_gpu *gpu,
+                          const char *name, h3_gpu_tensor *weight,
+                          uint64_t rows, uint64_t columns,
+                          char *error, size_t error_size) {
+    if (error && error_size) error[0] = '\0';
+    if (!set || !gpu || !name || !weight) {
+        fail(error, error_size, "invalid LoRA fuse arguments");
+        return 0;
+    }
+    size_t first = first_adapter_for(set, name);
+    size_t last = first;
+    uint64_t rank = 0;
+    for (; last < set->adapter_count &&
+           !strcmp(set->adapters[last].target, name); last++) {
+        const h3_lora_adapter *adapter = &set->adapters[last];
+        if (adapter->rows != rows || adapter->columns != columns) {
+            fail(error, error_size,
+                 "LoRA adapter for %s is %llux%llu but the weight is %llux%llu",
+                 name, (unsigned long long)adapter->rows,
+                 (unsigned long long)adapter->columns,
+                 (unsigned long long)rows, (unsigned long long)columns);
+            return 0;
+        }
+        rank += adapter->rank;
+    }
+    if (first == last) return 1;
+    /* The kernel indexes with 32-bit integers. */
+    if (rows > UINT32_MAX || columns > UINT32_MAX ||
+        rows * columns > UINT32_MAX || rows * rank > UINT32_MAX ||
+        columns * rank > UINT32_MAX) {
+        fail(error, error_size, "LoRA delta for %s is too large to fuse", name);
+        return 0;
+    }
+    size_t up_count = (size_t)(rows * rank);
+    size_t down_count = (size_t)(columns * rank);
+    float *up = calloc(up_count, sizeof(*up));
+    float *down = calloc(down_count, sizeof(*down));
+    float *factor = NULL;
+    size_t factor_capacity = 0;
+    uint64_t offset = 0;
+    h3_gpu_tensor *up_tensor = NULL;
+    h3_gpu_tensor *down_tensor = NULL;
+    char detail[384];
+    int ok = 0;
+    if (!up || !down) {
+        fail(error, error_size, "out of memory fusing LoRA into %s", name);
+        goto done;
+    }
+    /* Stacked adapters concatenate along the rank: sum_i s_i B_i A_i is
+     * [s_1 B_1 | s_2 B_2 ...] @ [A_1; A_2 ...], one product and one rounding.
+     * Down is stored column-major so each weight reads one contiguous run. */
+    for (size_t index = first; index < last; index++) {
+        const h3_lora_adapter *adapter = &set->adapters[index];
+        const h3_st_header *header = &set->files[adapter->file];
+        size_t up_elements = (size_t)(rows * adapter->rank);
+        size_t down_elements = (size_t)(adapter->rank * columns);
+        size_t needed = up_elements > down_elements ? up_elements :
+                                                      down_elements;
+        if (needed > factor_capacity) {
+            float *grown = realloc(factor, needed * sizeof(*grown));
+            if (!grown) {
+                fail(error, error_size, "out of memory fusing LoRA into %s",
+                     name);
+                goto done;
+            }
+            factor = grown;
+            factor_capacity = needed;
+        }
+        if (!read_values(header, adapter->up, factor, up_elements, detail,
+                         sizeof(detail))) {
+            fail(error, error_size, "LoRA %s: %s", base_name(header->path),
+                 detail);
+            goto done;
+        }
+        for (uint64_t row = 0; row < rows; row++) {
+            for (uint64_t k = 0; k < adapter->rank; k++) {
+                up[row * rank + offset + k] =
+                    adapter->scale * factor[row * adapter->rank + k];
+            }
+        }
+        if (!read_values(header, adapter->down, factor, down_elements, detail,
+                         sizeof(detail))) {
+            fail(error, error_size, "LoRA %s: %s", base_name(header->path),
+                 detail);
+            goto done;
+        }
+        for (uint64_t k = 0; k < adapter->rank; k++) {
+            for (uint64_t column = 0; column < columns; column++) {
+                down[column * rank + offset + k] =
+                    factor[k * columns + column];
+            }
+        }
+        offset += adapter->rank;
+    }
+    up_tensor = h3_gpu_tensor_from_f32(gpu, up, up_count);
+    down_tensor = h3_gpu_tensor_from_f32(gpu, down, down_count);
+    if (!up_tensor || !down_tensor || !h3_gpu_begin(gpu) ||
+        !h3_gpu_lora_fuse_bf16(gpu, weight, up_tensor, down_tensor,
+                               (uint32_t)rows, (uint32_t)columns,
+                               (uint32_t)rank) ||
+        !h3_gpu_submit(gpu)) {
+        fail(error, error_size, "cannot fuse LoRA into %s: %s", name,
+             h3_gpu_error(gpu));
+        goto done;
+    }
+    ok = 1;
+done:
+    h3_gpu_tensor_free(up_tensor);
+    h3_gpu_tensor_free(down_tensor);
+    free(factor);
+    free(up);
+    free(down);
+    return ok;
+}
diff --git a/h3_lora.h b/h3_lora.h
new file mode 100644
index 0000000..13f25bb
--- /dev/null
+++ b/h3_lora.h
@@ -0,0 +1,64 @@
+#ifndef H3_LORA_H
+#define H3_LORA_H
+
+#include "h3.h"
+#include "h3_gpu.h"
+#include "h3_weights.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* LoRA adapters, fused into the DiT's BF16 weights as they load.
+ *
+ * A LoRA is W' = W + scale * (up @ down). h3 needs no LoRA runtime for that:
+ * every DiT matrix is read exactly once, so the delta is added to the weight
+ * on its way in and every kernel after it, the int8 quantizers included, sees
+ * an ordinary checkpoint.
+ *
+ * The accepted layouts are the ones ComfyUI loads for MiniMax H3:
+ *
+ *   diffusion_model.<param>.lora_A.weight / .lora_B.weight
+ *   <param>.lora_A.weight / .lora_B.weight
+ *   lora_unet_<param, dots as underscores>.lora_down.weight / .lora_up.weight
+ *
+ * each with an optional .alpha, which makes the scale strength * alpha / rank
+ * (strength alone without one). A tensor outside those layouts refuses the
+ * whole file, as does an adapter that names no transformer weight.
+ *
+ * An adapter whose target exists but whose shape does not fit is skipped and
+ * counted, which is ComfyUI's rule too: some published H3 LoRAs carry AdaLN
+ * adapters trained against a pruned transformer with a narrower AdaLN input,
+ * and the rest of such a file still applies. A file where nothing fits is
+ * refused rather than applied as nothing. */
+
+typedef struct h3_lora_set h3_lora_set;
+
+/* Read every adapter file's header, map each pair onto a tensor in `store`
+ * and check it, reading no factor payloads beyond the scalar alphas. */
+h3_lora_set *h3_lora_set_open(const h3_weight_store *store,
+                              const h3_lora *loras, size_t count,
+                              char *error, size_t error_size);
+void h3_lora_set_free(h3_lora_set *set);
+
+size_t h3_lora_set_files(const h3_lora_set *set);
+/* Adapters that will be fused (zero-strength files contribute none). */
+size_t h3_lora_set_adapters(const h3_lora_set *set);
+/* Distinct transformer tensors those adapters change. */
+size_t h3_lora_set_tensors(const h3_lora_set *set);
+/* Adapters skipped because their shape does not fit this checkpoint, and the
+ * first of them in words ("" when none were). */
+size_t h3_lora_set_skipped(const h3_lora_set *set);
+const char *h3_lora_set_skip_detail(const h3_lora_set *set);
+
+int h3_lora_set_targets(const h3_lora_set *set, const char *name);
+
+/* Add every adapter aimed at `name` to `weight`, a writable BF16 matrix of
+ * rows x columns. Stacked adapters are concatenated along their rank, so each
+ * BF16 value is rounded once however many there are. Opens and submits its
+ * own Metal command, so no other command may be open. */
