diff --git a/tests/test_lora.c b/tests/test_lora.c
new file mode 100644
index 0000000..4688ad2
--- /dev/null
+++ b/tests/test_lora.c
@@ -0,0 +1,459 @@
+/* LoRA fusion against a synthetic checkpoint small enough to check by hand:
+ *
+ *   ./h3_lora_tests
+ *
+ * and against one real matrix, for comparison with an independent
+ * implementation:
+ *
+ *   ./h3_lora_tests --dump TRANSFORMER_DIR TENSOR ROWS COLUMNS OUT \
+ *       LORA STRENGTH [LORA STRENGTH ...]
+ *
+ * which writes TENSOR's fused BF16 bytes to OUT. */
+#include "h3_gpu.h"
+#include "h3_lora.h"
+#include "h3_weights.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { MAX_FILES = 16 };
+
+typedef struct {
+    const char *name;
+    const char *dtype;
+    int ndim;
+    uint64_t shape[2];
+    const float *values;
+} fixture;
+
+typedef struct {
+    const float *up;
+    const float *down;
+    uint64_t rank;
+    float scale;
+} reference_adapter;
+
+static char root[1024];
+static char created[MAX_FILES][1100];
+static size_t created_count;
+
+static void die(const char *message) {
+    fprintf(stderr, "FAIL tests/test_lora.c: %s\n", message);
+    exit(1);
+}
+
+static size_t elements_of(const fixture *tensor) {
+    size_t count = 1;
+    for (int dimension = 0; dimension < tensor->ndim; dimension++)
+        count *= (size_t)tensor->shape[dimension];
+    return count;
+}
+
+static uint16_t bf16_round(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    bits += 0x7fffu + ((bits >> 16) & 1u);
+    return (uint16_t)(bits >> 16);
+}
+
+static float bf16_float(uint16_t value) {
+    uint32_t bits = (uint32_t)value << 16;
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+/* Fixtures only hold values a half represents exactly. */
+static uint16_t f16_exact(float value) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    uint32_t sign = (bits >> 16) & 0x8000u;
+    uint32_t biased = (bits >> 23) & 0xffu;
+    if (!biased && !(bits & 0x7fffffu)) return (uint16_t)sign;
+    int exponent = (int)biased - 127 + 15;
+    if (exponent <= 0 || exponent >= 31 || (bits & 0x1fffu))
+        die("F16 fixture value is not exactly representable");
+    return (uint16_t)(sign | ((uint32_t)exponent << 10) |
+                      ((bits >> 13) & 0x3ffu));
+}
+
+static const char *write_safetensors(const char *name, const fixture *tensors,
+                                     size_t count) {
+    if (created_count == MAX_FILES) die("too many fixture files");
+    char *path = created[created_count++];
+    snprintf(path, sizeof(created[0]), "%s/%s", root, name);
+    char header[4096];
+    int used = snprintf(header, sizeof(header), "{");
+    size_t offset = 0;
+    for (size_t index = 0; index < count; index++) {
+        const fixture *tensor = &tensors[index];
+        size_t bytes = elements_of(tensor) *
+                       (strcmp(tensor->dtype, "F32") ? 2u : 4u);
+        char shape[64];
+        if (tensor->ndim == 2) {
+            snprintf(shape, sizeof(shape), "[%llu,%llu]",
+                     (unsigned long long)tensor->shape[0],
+                     (unsigned long long)tensor->shape[1]);
+        } else if (tensor->ndim == 1) {
+            snprintf(shape, sizeof(shape), "[%llu]",
+                     (unsigned long long)tensor->shape[0]);
+        } else {
+            snprintf(shape, sizeof(shape), "[]");
+        }
+        used += snprintf(header + used, sizeof(header) - (size_t)used,
+                         "%s\"%s\":{\"dtype\":\"%s\",\"shape\":%s,"
+                         "\"data_offsets\":[%zu,%zu]}",
+                         index ? "," : "", tensor->name, tensor->dtype, shape,
+                         offset, offset + bytes);
+        offset += bytes;
+    }
+    used += snprintf(header + used, sizeof(header) - (size_t)used, "}");
+    while ((8 + used) % 8) header[used++] = ' ';
+    if ((size_t)used >= sizeof(header)) die("fixture header overflow");
+    FILE *file = fopen(path, "wb");
+    if (!file) die("cannot create a fixture file");
+    uint64_t length = (uint64_t)used;
+    fwrite(&length, sizeof(length), 1, file);
+    fwrite(header, 1, (size_t)used, file);
+    for (size_t index = 0; index < count; index++) {
+        const fixture *tensor = &tensors[index];
+        for (size_t element = 0; element < elements_of(tensor); element++) {
+            float value = tensor->values[element];
+            if (!strcmp(tensor->dtype, "F32")) {
+                fwrite(&value, sizeof(value), 1, file);
+            } else {
+                uint16_t half = !strcmp(tensor->dtype, "BF16") ?
+                    bf16_round(value) : f16_exact(value);
+                fwrite(&half, sizeof(half), 1, file);
+            }
+        }
+    }
+    if (fclose(file) != 0) die("cannot write a fixture file");
+    return path;
+}
+
+/* Weights are multiples of 1/8 and factors multiples of 1/4, so every product
+ * and sum is exact in F32 and the only rounding is the final one to BF16 —
+ * which the expected values reproduce bit for bit, ties included. */
+static void fill_weight(float *values, size_t count, size_t seed) {
+    for (size_t index = 0; index < count; index++)
+        values[index] = (float)((int)((index * 37u + seed * 11u) % 61u) - 30) /
+                        8.0f;
+}
+
+static void fill_factor(float *values, size_t count, size_t seed) {
+    for (size_t index = 0; index < count; index++)
+        values[index] = (float)((int)((index * 13u + seed * 7u) % 25u) - 12) /
+                        4.0f;
+}
+
+static h3_gpu_tensor *load(const h3_weight_store *store, h3_gpu *gpu,
+                           const char *name, uint64_t rows, uint64_t columns) {
+    uint64_t shape[] = {rows, columns};
+    char error[512];
+    h3_gpu_tensor *tensor = h3_weight_load_bf16(store, gpu, name, 2, shape,
+                                                error, sizeof(error));
+    if (!tensor) die(error);
+    return tensor;
+}
+
+static void expect_fused(const h3_weight_store *store, h3_gpu *gpu,
+                         const char *name, const float *weight, uint64_t rows,
+                         uint64_t columns, const reference_adapter *adapters,
+                         size_t count) {
+    h3_gpu_tensor *tensor = load(store, gpu, name, rows, columns);
+    size_t elements = (size_t)(rows * columns);
+    uint16_t *got = malloc(elements * sizeof(*got));
+    if (!got || !h3_gpu_tensor_read_bf16(tensor, got, elements))
+        die("cannot read a loaded matrix back");
+    for (uint64_t row = 0; row < rows; row++) {
+        for (uint64_t column = 0; column < columns; column++) {
+            float delta = 0.0f;
+            for (size_t index = 0; index < count; index++) {
+                const reference_adapter *adapter = &adapters[index];
+                for (uint64_t k = 0; k < adapter->rank; k++) {
+                    delta += adapter->scale *
+                             adapter->up[row * adapter->rank + k] *
+                             adapter->down[k * columns + column];
+                }
+            }
+            uint16_t base = bf16_round(weight[row * columns + column]);
+            uint16_t want = bf16_round(bf16_float(base) + delta);
+            uint16_t have = got[row * columns + column];
+            if (have != want) {
+                fprintf(stderr, "%s[%llu,%llu]: got %#06x (%g), want %#06x (%g)\n",
+                        name, (unsigned long long)row,
+                        (unsigned long long)column, have,
+                        (double)bf16_float(have), want,
+                        (double)bf16_float(want));
+                die("fused value mismatch");
+            }
+        }
+    }
+    printf("lora %-40s %llux%llu, %zu adapters, bit-exact\n", name,
+           (unsigned long long)rows, (unsigned long long)columns, count);
+    free(got);
+    h3_gpu_tensor_free(tensor);
+}
+
+static void expect_refused(const h3_weight_store *store, const char *path,
+                           const char *needle) {
+    h3_lora lora = {path, 1.0f};
+    char error[512];
+    h3_lora_set *set = h3_lora_set_open(store, &lora, 1, error, sizeof(error));
+    if (set) {
+        h3_lora_set_free(set);
+        fprintf(stderr, "expected a refusal containing \"%s\"\n", needle);
+        die("a LoRA that should be refused was accepted");
+    }
+    if (!strstr(error, needle)) {
+        fprintf(stderr, "refused with: %s\n", error);
+        die("a LoRA was refused for the wrong reason");
+    }
+    printf("lora refused %-18s %s\n", strrchr(path, '/') + 1, error);
+}
+
+static double now_seconds(void) {
+    struct timespec value;
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    return (double)value.tv_sec + (double)value.tv_nsec * 1e-9;
+}
+
+static int dump(int argc, char **argv) {
+    if (argc < 9 || (argc - 7) % 2) {
+        fprintf(stderr,
+                "usage: %s --dump TRANSFORMER_DIR TENSOR ROWS COLUMNS OUT "
+                "LORA STRENGTH [LORA STRENGTH ...]\n", argv[0]);
+        return 2;
+    }
+    size_t count = (size_t)(argc - 7) / 2;
+    if (count > H3_MAX_LORAS) die("too many LoRAs");
+    h3_lora loras[H3_MAX_LORAS];
+    for (size_t index = 0; index < count; index++) {
+        loras[index].path = argv[7 + 2 * index];
+        loras[index].strength = strtof(argv[8 + 2 * index], NULL);
+    }
+    uint64_t rows = strtoull(argv[4], NULL, 10);
+    uint64_t columns = strtoull(argv[5], NULL, 10);
+    char error[512];
+    h3_weight_store *store = h3_weight_store_open(argv[2], error, sizeof(error));
+    if (!store) die(error);
+    h3_lora_set *set = h3_lora_set_open(store, loras, count, error,
+                                        sizeof(error));
+    if (!set) die(error);
+    h3_gpu *gpu = h3_gpu_create("h3_shaders.metal", error, sizeof(error));
+    if (!gpu) die(error);
+    h3_weight_store_attach_loras(store, set);
+    double started = now_seconds();
+    h3_gpu_tensor *tensor = load(store, gpu, argv[3], rows, columns);
+    double seconds = now_seconds() - started;
+    size_t elements = (size_t)(rows * columns);
+    uint16_t *values = malloc(elements * sizeof(*values));
+    if (!values || !h3_gpu_tensor_read_bf16(tensor, values, elements))
+        die("cannot read the fused matrix back");
+    FILE *output = fopen(argv[6], "wb");
+    if (!output || fwrite(values, sizeof(*values), elements, output) != elements ||
+        fclose(output) != 0) die("cannot write the dump");
+    printf("%s: %zu adapters on %zu tensors, %zu skipped%s%s; "
+           "loaded and fused in %.3fs\n", argv[3], h3_lora_set_adapters(set),
+           h3_lora_set_tensors(set), h3_lora_set_skipped(set),
+           h3_lora_set_skipped(set) ? ": " : "", h3_lora_set_skip_detail(set),
+           seconds);
+    free(values);
+    h3_gpu_tensor_free(tensor);
+    h3_gpu_free(gpu);
+    h3_weight_store_attach_loras(store, NULL);
+    h3_lora_set_free(set);
+    h3_weight_store_free(store);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc > 1 && !strcmp(argv[1], "--dump")) return dump(argc, argv);
+
+    const char *temporary = getenv("TMPDIR");
+    snprintf(root, sizeof(root), "%s/h3_lora_testXXXXXX",
+             temporary && *temporary ? temporary : "/tmp");
+    if (!mkdtemp(root)) die("cannot create a temporary directory");
+    char transformer[1100];
+    snprintf(transformer, sizeof(transformer), "%s/transformer", root);
+    if (mkdir(transformer, 0700) != 0) die("cannot create a transformer directory");
+
+    float qkv[24], fc2[20], fc1[12], adaln[24], norm[4], time_w[4];
+    fill_weight(qkv, 24, 1);
+    fill_weight(fc2, 20, 2);
+    fill_weight(fc1, 12, 3);
+    fill_weight(adaln, 24, 4);
+    fill_weight(norm, 4, 5);
+    fill_weight(time_w, 4, 6);
+    const fixture checkpoint[] = {
+        {"time_embedder.proj_in.weight", "F32", 2, {2, 2}, time_w},
+        {"blocks.0.attn.qkv_proj.weight", "BF16", 2, {6, 4}, qkv},
+        {"blocks.0.mlp.fc2.weight", "BF16", 2, {4, 5}, fc2},
+        {"token_refiner.blocks.1.mlp.fc1.weight", "BF16", 2, {3, 4}, fc1},
+        {"blocks.0.adaln_proj.linear.weight", "BF16", 2, {8, 3}, adaln},
+        {"blocks.0.norm1.weight", "BF16", 1, {4, 0}, norm},
+    };
+    write_safetensors("transformer/model.safetensors", checkpoint, 6);
+
+    float peft_down[8], peft_up[12], misfit_down[10], misfit_up[16];
+    fill_factor(peft_down, 8, 1);
+    fill_factor(peft_up, 12, 2);
+    fill_factor(misfit_down, 10, 3);
+    fill_factor(misfit_up, 16, 4);
+    /* ComfyUI's spelling, no alpha, plus an AdaLN adapter trained for a
+     * narrower AdaLN input: the pruned-transformer case. */
+    const fixture peft[] = {
+        {"diffusion_model.blocks.0.attn.qkv_proj.lora_A.weight", "F32", 2, {2, 4}, peft_down},
+        {"diffusion_model.blocks.0.adaln_proj.linear.lora_A.weight", "F32", 2, {2, 5}, misfit_down},
+        {"diffusion_model.blocks.0.attn.qkv_proj.lora_B.weight", "BF16", 2, {6, 2}, peft_up},
+        {"diffusion_model.blocks.0.adaln_proj.linear.lora_B.weight", "BF16", 2, {8, 2}, misfit_up},
+    };
+    float kohya_down[8], kohya_up[6], kohya_qkv_down[4], kohya_qkv_up[6];
+    float alpha_one = 1.0f, alpha_two = 2.0f;
+    fill_factor(kohya_down, 8, 5);
+    fill_factor(kohya_up, 6, 6);
+    fill_factor(kohya_qkv_down, 4, 7);
+    fill_factor(kohya_qkv_up, 6, 8);
+    /* kohya's spelling, F32 and BF16 scalar alphas, an F16 factor, and a second
+     * adapter on the matrix the file above also changes. */
+    const fixture kohya[] = {
+        {"lora_unet_token_refiner_blocks_1_mlp_fc1.alpha", "F32", 0, {0, 0}, &alpha_one},
+        {"lora_unet_token_refiner_blocks_1_mlp_fc1.lora_up.weight", "F32", 2, {3, 2}, kohya_up},
+        {"lora_unet_blocks_0_attn_qkv_proj.lora_down.weight", "F32", 2, {1, 4}, kohya_qkv_down},
+        {"lora_unet_token_refiner_blocks_1_mlp_fc1.lora_down.weight", "F16", 2, {2, 4}, kohya_down},
+        {"lora_unet_blocks_0_attn_qkv_proj.alpha", "BF16", 0, {0, 0}, &alpha_two},
+        {"lora_unet_blocks_0_attn_qkv_proj.lora_up.weight", "F32", 2, {6, 1}, kohya_qkv_up},
+    };
+    float bare_down[10], bare_up[8];
+    fill_factor(bare_down, 10, 9);
+    fill_factor(bare_up, 8, 10);
+    const fixture bare[] = {
+        {"blocks.0.mlp.fc2.lora_A.weight", "BF16", 2, {2, 5}, bare_down},
+        {"blocks.0.mlp.fc2.lora_B.weight", "F16", 2, {4, 2}, bare_up},
+    };
+    const char *peft_path = write_safetensors("peft.safetensors", peft, 4);
+    const char *kohya_path = write_safetensors("kohya.safetensors", kohya, 6);
+    const char *bare_path = write_safetensors("bare.safetensors", bare, 2);
+
+    char error[512];
+    h3_weight_store *store = h3_weight_store_open(transformer, error,
+                                                  sizeof(error));
+    if (!store) die(error);
+    h3_gpu *gpu = h3_gpu_create("h3_shaders.metal", error, sizeof(error));
+    if (!gpu) die(error);
+
+    h3_lora loras[] = {{peft_path, 0.5f}, {kohya_path, -0.5f}, {bare_path, 0.75f}};
+    h3_lora_set *set = h3_lora_set_open(store, loras, 3, error, sizeof(error));
+    if (!set) die(error);
+    if (h3_lora_set_files(set) != 3 || h3_lora_set_adapters(set) != 4 ||
+        h3_lora_set_tensors(set) != 3 || h3_lora_set_skipped(set) != 1)
+        die("adapter accounting is wrong");
+    if (!strstr(h3_lora_set_skip_detail(set), "blocks.0.adaln_proj.linear.weight"))
+        die("the skipped adapter is not named");
+    if (!h3_lora_set_targets(set, "blocks.0.attn.qkv_proj.weight") ||
+        h3_lora_set_targets(set, "blocks.0.adaln_proj.linear.weight") ||
+        h3_lora_set_targets(set, "blocks.0.norm1.weight"))
+        die("target lookup is wrong");
+
+    h3_weight_store_attach_loras(store, set);
+    /* Two files on one matrix, stacked; alpha / rank scales the kohya one. */
+    const reference_adapter qkv_adapters[] = {
+        {peft_up, peft_down, 2, 0.5f},
+        {kohya_qkv_up, kohya_qkv_down, 1, -0.5f * 2.0f / 1.0f},
+    };
+    expect_fused(store, gpu, "blocks.0.attn.qkv_proj.weight", qkv, 6, 4,
+                 qkv_adapters, 2);
+    const reference_adapter fc1_adapters[] = {
+        {kohya_up, kohya_down, 2, -0.5f * 1.0f / 2.0f},
+    };
+    expect_fused(store, gpu, "token_refiner.blocks.1.mlp.fc1.weight", fc1, 3, 4,
+                 fc1_adapters, 1);
+    const reference_adapter fc2_adapters[] = {{bare_up, bare_down, 2, 0.75f}};
+    expect_fused(store, gpu, "blocks.0.mlp.fc2.weight", fc2, 4, 5,
+                 fc2_adapters, 1);
+    /* The skipped adapter's matrix loads exactly as written. */
+    expect_fused(store, gpu, "blocks.0.adaln_proj.linear.weight", adaln, 8, 3,
+                 NULL, 0);
+    uint64_t norm_shape[] = {4};
+    h3_gpu_tensor *norm_tensor = h3_weight_load_bf16(
+        store, gpu, "blocks.0.norm1.weight", 1, norm_shape, error, sizeof(error));
+    uint16_t norm_got[4];
+    if (!norm_tensor || !h3_gpu_tensor_read_bf16(norm_tensor, norm_got, 4))
+        die("an untargeted vector did not load");
+    for (size_t index = 0; index < 4; index++)
+        if (norm_got[index] != bf16_round(norm[index]))
+            die("an untargeted vector changed");
+    h3_gpu_tensor_free(norm_tensor);
+    /* Detached, the store is the plain checkpoint again. */
+    h3_weight_store_attach_loras(store, NULL);
+    expect_fused(store, gpu, "blocks.0.attn.qkv_proj.weight", qkv, 6, 4,
+                 NULL, 0);
+
+    h3_lora silent = {bare_path, 0.0f};
+    h3_lora_set *zero = h3_lora_set_open(store, &silent, 1, error, sizeof(error));
+    if (!zero || h3_lora_set_adapters(zero) ||
+        h3_lora_set_targets(zero, "blocks.0.mlp.fc2.weight"))
+        die("a zero-strength LoRA must fuse nothing");
+    h3_lora_set_free(zero);
+    printf("lora zero strength fuses nothing\n");
+
+    const fixture stranger[] = {
+        {"diffusion_model.blocks.9.attn.qkv_proj.lora_A.weight", "F32", 2, {2, 4}, peft_down},
+        {"diffusion_model.blocks.9.attn.qkv_proj.lora_B.weight", "F32", 2, {6, 2}, peft_up},
+    };
+    const fixture unknown[] = {
+        {"blocks.0.attn.qkv_proj.lora_A.weight", "F32", 2, {2, 4}, peft_down},
+        {"blocks.0.attn.qkv_proj.lora_B.weight", "F32", 2, {6, 2}, peft_up},
+        {"blocks.0.attn.qkv_proj.dora_scale", "F32", 2, {6, 1}, kohya_qkv_up},
+    };
+    const fixture f32_target[] = {
+        {"time_embedder.proj_in.lora_A.weight", "F32", 2, {1, 2}, kohya_qkv_down},
+        {"time_embedder.proj_in.lora_B.weight", "F32", 2, {2, 1}, kohya_qkv_down},
+    };
+    const fixture misfit[] = {
+        {"blocks.0.adaln_proj.linear.lora_A.weight", "F32", 2, {2, 5}, misfit_down},
+        {"blocks.0.adaln_proj.linear.lora_B.weight", "F32", 2, {8, 2}, misfit_up},
+    };
+    const fixture unpaired[] = {
+        {"blocks.0.mlp.fc2.lora_A.weight", "F32", 2, {2, 5}, bare_down},
+    };
+    const fixture ranks[] = {
+        {"blocks.0.mlp.fc2.lora_A.weight", "F32", 2, {2, 5}, bare_down},
+        {"blocks.0.mlp.fc2.lora_B.weight", "F32", 2, {4, 1}, bare_up},
+    };
+    const fixture twice[] = {
+        {"blocks.0.mlp.fc2.lora_A.weight", "F32", 2, {2, 5}, bare_down},
+        {"blocks.0.mlp.fc2.lora_B.weight", "F32", 2, {4, 2}, bare_up},
+        {"diffusion_model.blocks.0.mlp.fc2.lora_A.weight", "F32", 2, {2, 5}, bare_down},
+        {"diffusion_model.blocks.0.mlp.fc2.lora_B.weight", "F32", 2, {4, 2}, bare_up},
+    };
+    expect_refused(store, write_safetensors("stranger.safetensors", stranger, 2),
+                   "names no MiniMax H3 transformer weight");
+    expect_refused(store, write_safetensors("unknown.safetensors", unknown, 3),
+                   "dora_scale is not a factor");
+    expect_refused(store, write_safetensors("f32.safetensors", f32_target, 2),
+                   "only BF16 matrices");
+    expect_refused(store, write_safetensors("misfit.safetensors", misfit, 2),
+                   "fit this checkpoint");
+    expect_refused(store, write_safetensors("unpaired.safetensors", unpaired, 1),
+                   "no up factor");
+    expect_refused(store, write_safetensors("ranks.safetensors", ranks, 2),
+                   "rank");
+    expect_refused(store, write_safetensors("twice.safetensors", twice, 4),
+                   "two adapters target");
+
+    h3_lora_set_free(set);
+    h3_gpu_free(gpu);
+    h3_weight_store_free(store);
+    for (size_t index = created_count; index-- > 0;) unlink(created[index]);
+    rmdir(transformer);
+    rmdir(root);
+    printf("lora fusion tests passed\n");
+    return 0;
+}
