{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "ACE-Step 1.5 turbo (all-in-one)"},
    "inputs": {"ckpt_name": "ace_step_1.5_turbo_aio.safetensors"}
  },
  "2": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "_meta": {"title": "Song"},
    "inputs": {
      "clip": ["1", 1],
      "tags": "warm indie folk, acoustic guitar, brushed drums, upright bass, female lead vocal, intimate close recording",
      "lyrics": "",
      "seed": 0,
      "bpm": 92,
      "duration": 60.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "3": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Negative"},
    "inputs": {"conditioning": ["2", 0]}
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Sampling shift"},
    "inputs": {"model": ["1", 0], "shift": 3.0}
  },
  "5": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "_meta": {"title": "Length"},
    "inputs": {"seconds": 60.0, "batch_size": 1}
  },
  "6": {
    "class_type": "KSampler",
    "_meta": {"title": "Render"},
    "inputs": {
      "model": ["4", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0],
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecodeAudio",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["6", 0], "vae": ["1", 2]}
  },
  "8": {
    "class_type": "SaveAudio",
    "_meta": {"title": "Save lossless master"},
    "inputs": {"audio": ["7", 0], "filename_prefix": "audio/hivemind-music"}
  }
}
