{
  "comment": "MiniMax H3 text/image-to-video+audio, API format. Expanded from the official Comfy-Org video_minimax_h3 template (t2v/i2v share one graph: node 70 LoadImage -> first_frame is pruned by the MCP builder when no anchor image is supplied; image_clear=prune in the registry entry). SpectrumApplyMiniMaxH3 (node 30) rides the MODEL edge with the conservative preset (~1.4x faster RES sampling, final 3 steps always native) — the executing Comfy lane must have ComfyUI >= e377e263 (2026-08-03) and the ComfyUI-Spectrum-MiniMax-H3 custom node (see packages/gpu-rentals/provisioning). Length is frames on the 17k+5 grid at 24 fps (124 = ~5s); the node snaps up internally.",
  "prompt": {
    "6": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "13": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      }
    },
    "11": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      }
    },
    "24": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    },
    "30": {
      "class_type": "SpectrumApplyMiniMaxH3",
      "inputs": {
        "model": ["6", 0],
        "enabled": true,
        "blend_weight": 0.5,
        "degree": 4,
        "ridge_lambda": 0.1,
        "window_size": 2.0,
        "flex_window": 0.75,
        "warmup_steps": 5,
        "tail_actual_steps": 1,
        "max_history": 8,
        "debug": false,
        "history_storage": "system_ram"
      }
    },
    "70": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "104": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": ["13", 0],
        "vae": ["11", 0],
        "prompt": "",
        "width": 1216,
        "height": 704,
        "length": 124,
        "first_frame": ["70", 0]
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": ["30", 0],
        "scheduler": "simple",
        "steps": 20,
        "denoise": 1.0
      }
    },
    "17": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      }
    },
    "15": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 42
      }
    },
    "16": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": ["30", 0],
        "conditioning": ["104", 0]
      }
    },
    "14": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["15", 0],
        "guider": ["16", 0],
        "sampler": ["17", 0],
        "sigmas": ["9", 0],
        "latent_image": ["104", 1]
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["14", 0],
        "vae": ["11", 0]
      }
    },
    "23": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": ["14", 0],
        "vae": ["24", 0]
      }
    },
    "91": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["10", 0],
        "audio": ["23", 0],
        "fps": 24
      }
    },
    "92": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["91", 0],
        "filename_prefix": "video/minimax_h3",
        "format": "mp4",
        "codec": "h264"
      }
    }
  }
}
