# Build output and everything tauri-build regenerates from tauri.conf.json,
# build.rs and the capabilities. Checking these in means reviewing a diff of
# machine-written JSON on every command rename.
src-tauri/target/
src-tauri/gen/
src-tauri/permissions/autogenerated/

# What the packaging step stages into the bundle: the frozen interpreter, the
# Node binary, the application tree with its node_modules and the built
# frontends. Gigabytes, all of it reproducible from this checkout by
# scripts/stage_desktop_resources.py. Only the placeholders are tracked —
# `tauri-build` refuses to compile when a path named in `bundle.resources` does
# not exist, so a checkout that has built nothing still needs the shape.
src-tauri/resources/*
!src-tauri/resources/runtime.json
!src-tauri/resources/desktop-python/
!src-tauri/resources/node/
!src-tauri/resources/studio/
!src-tauri/resources/legal/
src-tauri/resources/*/*
!src-tauri/resources/*/PLACEHOLDER.md
