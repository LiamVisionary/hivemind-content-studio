{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivemind Content Studio",
  "mainBinaryName": "hivemind-content-studio",
  "version": "0.1.0",
  "identifier": "ai.hivemindos.content-studio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hivemind Content Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LiamVisionary/hivemind-content-studio/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
